# Better Auth Configuration
AUTH_SECRET=your-auth-secret-key-here
BETTER_AUTH_SECRET=your-auth-secret-key-here  # Can use AUTH_SECRET or BETTER_AUTH_SECRET
BETTER_AUTH_URL=http://localhost:3000  # Optional, defaults to NEXT_PUBLIC_APP_URL

# Google OAuth Credentials
# Get these from Google Cloud Console > APIs & Services > Credentials
# 1. Go to Google Cloud Console
# 2. Navigate to APIs & Services > Credentials
# 3. Click "Create Credentials" > "OAuth 2.0 Client ID"
# 4. Set Application type to "Web application"
# 5. Add authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google (for development)
#    - https://yourdomain.com/api/auth/callback/google (for production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Video Generation Provider API Keys
# Set the keys for the providers you use. Providers without a key show
# "(no API key)" in the UI and cannot be submitted.

# veo3gen.app (Imaginary): Google Veo 3.1 Fast, Quality and Lite
# Docs: https://www.imaginary.app/docs (keys start with veo_)
VEO3_API_KEY=veo_your-veo3-api-key-here

# Runway API: Gen-4.5, Veo 3.1, Veo 3.1 Fast, Kling 4, Seedance 2.5, Wan 3
# Create a key at https://dev.runwayml.com/ (RUNWAYML_API_KEY is also read)
RUNWAYML_API_SECRET=your-runway-api-secret-here

# Luma Agents API: Ray 3.2
# Create a key at https://platform.lumalabs.ai/ (LUMA_API_KEY is also read)
LUMA_AGENTS_API_KEY=your-luma-agents-api-key-here

# OpenAI Sora was removed: OpenAI shut down the Videos API on 2026-09-24.
